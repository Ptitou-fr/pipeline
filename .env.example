# Base Turso (libSQL). Modèle sans valeur réelle : les vraies valeurs vont dans les variables
# d'environnement du projet Vercel (Production), jamais dans le dépôt.
#
# En local, laisser commenté : la base est alors le fichier .data/pipeline.db (ignoré par git).
# Sur Vercel, TURSO_DATABASE_URL est obligatoire : sans elle, l'app refuse d'ouvrir la base.
# TURSO_DATABASE_URL=libsql://<base>-<organisation>.turso.io
# TURSO_AUTH_TOKEN=
